# =============================================================================
# TTS-Engine configuration
# Copy to .env and edit. Loaded automatically when started via uvicorn/dotenv.
# =============================================================================

# Which streaming engine to load. "xtts" (default) keeps the Phase 1 behavior;
# "chattts" switches to the Phase 5 conversational engine.
TTS_ENGINE=xtts

# -----------------------------------------------------------------------------
# Shared (used by both engines)
# -----------------------------------------------------------------------------
DEFAULT_SPEAKER_WAV=VO_Escoffier.wav
TTS_STREAM_SAMPLE_RATE=24000
TTS_STREAM_CHUNK_SIZE=20
TTS_STREAM_OVERLAP_LEN=1024

# Used only by the legacy /synthesize MP3 endpoint.
TTS_MP3_BITRATE=48k
TTS_MP3_SAMPLE_RATE=24000
TTS_LEADING_SILENCE_MS=900
AUDIO_TTL_SECONDS=900
# FFMPEG_BIN=C:\path\to\ffmpeg.exe
# PUBLIC_BASE_URL=https://your-ngrok-host.example

# -----------------------------------------------------------------------------
# XTTS-specific
# -----------------------------------------------------------------------------
TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2

# -----------------------------------------------------------------------------
# ChatTTS-specific (only consulted when TTS_ENGINE=chattts)
# -----------------------------------------------------------------------------
CHATTTS_MODEL_DIR=./models/chattts
CHATTTS_COMPILE=1
CHATTTS_REFINE_TEMP=0.3
CHATTTS_INFER_TEMP=0.3

# -----------------------------------------------------------------------------
# STT (faster-whisper) — used by the upstream voice path POST /transcribe.
# `base.en` is the recommended starting point. Bigger = more accurate + slower.
# Options: tiny.en | base.en | small.en | medium.en | large-v3
# -----------------------------------------------------------------------------
STT_MODEL=base.en
# STT_DEVICE=auto              # auto | cuda | cpu
# STT_COMPUTE_TYPE=default     # default | float16 | int8_float16 | int8
